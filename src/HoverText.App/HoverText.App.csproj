<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <ProjectReference Include="..\HoverText.Core\HoverText.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ApplicationIcon>Assets\hovertext.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>HoverText</Product>
    <AssemblyTitle>HoverText - Windows Hover Text and Cursor Magnifier</AssemblyTitle>
    <Description>Local Windows accessibility utility with Hover Text-style reading, UI Automation text capture, optional OCR fallback, and GDI/native/GPU screen magnifier backends for low-vision users.</Description>
    <Authors>ferhas</Authors>
    <RepositoryUrl>https://github.com/ferhas/hovertext</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ferhas/hovertext</PackageProjectUrl>
    <PackageTags>windows;accessibility;low-vision;hover-text;screen-magnifier;cursor-magnifier;text-reader;ocr;ui-automation;directx;wpf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\hovertext.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\hovertext-icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
