<Window x:Class="HoverText.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="Shell"
            Background="#111827"
            BorderBrush="#f8fafc"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="720"
            Padding="16,12">
        <StackPanel>
            <TextBlock x:Name="SourceLabel"
                       FontSize="12"
                       Foreground="#93c5fd"
                       Margin="0,0,0,4"/>
            <Image x:Name="MagnifierImage"
                   Height="220"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>
            <TextBlock x:Name="DisplayText"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
