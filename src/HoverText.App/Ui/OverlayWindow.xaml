<Window x:Class="HoverText.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Border x:Name="Shell"
            Background="#111827"
            BorderBrush="#f8fafc"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="720"
            Padding="16,12"
            RenderOptions.CachingHint="Cache"
            SnapsToDevicePixels="True">
        <Border.CacheMode>
            <BitmapCache EnableClearType="True"
                         RenderAtScale="1"/>
        </Border.CacheMode>
        <StackPanel>
            <TextBlock x:Name="SourceLabel"
                       FontSize="12"
                       Foreground="#93c5fd"
                       Margin="0,0,0,4"/>
            <Image x:Name="MagnifierImage"
                   Height="220"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.CachingHint="Cache"
                   SnapsToDevicePixels="True"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>
            <TextBlock x:Name="DisplayText"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="InputEditor"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="#22d3ee"
                     FontFamily="Segoe UI"
                     FontWeight="SemiBold"
                     Foreground="#f8fafc"
                     MinHeight="132"
                     MinWidth="560"
                     Padding="0"
                     TextChanged="InputEditor_TextChanged"
                     TextWrapping="Wrap"
                     Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
