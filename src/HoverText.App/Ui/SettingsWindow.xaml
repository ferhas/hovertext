<Window x:Class="HoverText.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverText Settings"
        Width="420"
        Height="430"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Trigger key" Margin="0,0,12,12"/>
        <ComboBox x:Name="TriggerKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Font size" Margin="0,0,12,12"/>
        <Slider x:Name="FontSizeSlider" Grid.Row="1" Grid.Column="1" Minimum="32" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Poll interval" Margin="0,0,12,12"/>
        <Slider x:Name="PollIntervalSlider" Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="300" TickFrequency="25" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Text color" Margin="0,0,12,12"/>
        <TextBox x:Name="ForegroundBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Background" Margin="0,0,12,12"/>
        <TextBox x:Name="BackgroundBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"/>

        <CheckBox x:Name="OcrBox" Grid.Row="5" Grid.Column="1" Content="Enable OCR fallback" Margin="0,0,0,12"/>
        <CheckBox x:Name="StartupBox" Grid.Row="6" Grid.Column="1" Content="Start with Windows" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="88" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
