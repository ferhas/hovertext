<Window x:Class="HoverText.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverText 设置"
        Width="720"
        Height="820"
        MinWidth="680"
        MinHeight="760"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowTopBrush" Color="#07110f"/>
        <SolidColorBrush x:Key="WindowBottomBrush" Color="#151019"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#141716"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0b1210"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35423b"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#24302b"/>
        <SolidColorBrush x:Key="TextBrush" Color="#fff7ed"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#b7c7bc"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#34d399"/>
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#10b981"/>
        <SolidColorBrush x:Key="WarmBrush" Color="#f59e0b"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#fb7185"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HeaderCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,12"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#202823"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25332d"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#102a21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#06120e"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#151d19"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator VerticalAlignment="Center">
                            <BulletDecorator.Bullet>
                                <Border x:Name="CheckBoxBorder"
                                        Width="24"
                                        Height="24"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Path x:Name="CheckMark"
                                          Data="M 5 12 L 10 17 L 19 7"
                                          Stroke="#06120e"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07110f" Offset="0"/>
                <GradientStop Color="#151019" Offset="0.62"/>
                <GradientStop Color="#100f0b" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Border Width="52"
                        Height="52"
                        CornerRadius="8"
                        Background="{StaticResource AccentBrush}"
                        DockPanel.Dock="Left"
                        Margin="0,0,14,0">
                    <TextBlock Text="HT"
                               Foreground="#06120e"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="HoverText 设置"
                               FontSize="34"
                               FontWeight="SemiBold"
                               LineHeight="38"/>
                    <TextBlock Text="调整触发方式、悬浮文字外观和识别兜底；保存后立即生效。"
                               Style="{StaticResource HeaderCaption}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="快捷触发" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="选择按住哪个键时显示悬浮文字。"
                                       Style="{StaticResource SectionDescription}"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="AltButton" Content="Alt" Width="92" Margin="0,0,10,0" Click="TriggerButton_Click"/>
                                <Button x:Name="ControlButton" Content="Ctrl" Width="92" Margin="0,0,10,0" Click="TriggerButton_Click"/>
                                <Button x:Name="ShiftButton" Content="Shift" Width="92" Click="TriggerButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="显示外观" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="控制悬浮文字的字号、刷新速度和高对比配色。"
                                       Style="{StaticResource SectionDescription}"/>

                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="悬浮字号"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="FontSizeValue" Style="{StaticResource ValueText}"/>
                                    <Slider x:Name="FontSizeSlider"
                                            Minimum="40"
                                            Maximum="112"
                                            TickFrequency="4"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="Slider_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="刷新间隔"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PollIntervalValue" Style="{StaticResource ValueText}"/>
                                    <Slider x:Name="PollIntervalSlider"
                                            Minimum="80"
                                            Maximum="300"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="Slider_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="文字颜色"/>
                                <StackPanel Grid.Column="1" Margin="0,0,0,18">
                                    <TextBox x:Name="ForegroundBox"/>
                                    <WrapPanel>
                                        <Button Tag="#f8fafc" Margin="0,0,8,8" Click="ForegroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#f8fafc" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="白色" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="#22d3ee" Margin="0,0,8,8" Click="ForegroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#22d3ee" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="青色" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="#fde68a" Margin="0,0,0,8" Click="ForegroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#fde68a" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="暖黄" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="背景颜色"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="BackgroundBox"/>
                                    <WrapPanel>
                                        <Button Tag="#111827" Margin="0,0,8,0" Click="BackgroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="深蓝" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="#020617" Margin="0,0,8,0" Click="BackgroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#020617" BorderBrush="#475569" BorderThickness="1" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="墨黑" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="#1e1b4b" Click="BackgroundPreset_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" Background="#1e1b4b" BorderBrush="#6366f1" BorderThickness="1" CornerRadius="7" Margin="0,0,8,0"/>
                                                <TextBlock Text="靛紫" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="识别能力" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="UI Automation 无法读取文字时，可继续尝试 OCR 或局部像素放大。"
                                       Style="{StaticResource SectionDescription}"/>
                            <CheckBox x:Name="OcrBox" Grid.Row="2" Content="启用 OCR 兜底"/>
                            <CheckBox x:Name="MagnifierBox" Grid.Row="3" Content="启用放大镜模式"/>
                            <CheckBox x:Name="HoverTypingBox" Grid.Row="4" Content="启用输入时大字显示"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="系统偏好" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="控制 HoverText 是否随 Windows 启动，并可快速回到推荐默认值。"
                                       Style="{StaticResource SectionDescription}"/>
                            <CheckBox x:Name="StartupBox" Grid.Row="2" Content="开机自动启动 HoverText"/>
                            <Button Grid.Row="3"
                                    Content="恢复默认设置"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource QuietButton}"
                                    Click="Reset_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,16,0,0"
                    Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}"
                            Click="Cancel_Click"/>
                    <Button Content="保存"
                            Width="124"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
