<Window x:Class="HoverText.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverText 设置"
        Width="660"
        Height="760"
        MinWidth="660"
        MinHeight="760"
        MaxWidth="660"
        MaxHeight="760"
        ResizeMode="NoResize"
        Background="#080d18"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0f172a"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="TextBrush" Color="#f8fafc"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#a8b3c7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22d3ee"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26344f"/>
                    <Setter Property="BorderBrush" Value="#22d3ee"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator VerticalAlignment="Center">
                            <BulletDecorator.Bullet>
                                <Border x:Name="CheckBoxBorder"
                                        Width="24"
                                        Height="24"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Path x:Name="CheckMark"
                                          Data="M 5 12 L 10 17 L 19 7"
                                          Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0891b2"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#26344f"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="HoverText 设置"
                           FontSize="32"
                           FontWeight="SemiBold"/>
                <TextBlock Text="点击托盘图标打开设置；保存后立即生效。"
                           FontSize="18"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="触发键"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="AltButton" Content="Alt" Width="88" Margin="0,0,8,0" Click="TriggerButton_Click"/>
                    <Button x:Name="ControlButton" Content="Ctrl" Width="88" Margin="0,0,8,0" Click="TriggerButton_Click"/>
                    <Button x:Name="ShiftButton" Content="Shift" Width="88" Click="TriggerButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="悬浮字号"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock x:Name="FontSizeValue" FontSize="19" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <Slider x:Name="FontSizeSlider" Minimum="56" Maximum="112" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="刷新间隔"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock x:Name="PollIntervalValue" FontSize="19" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <Slider x:Name="PollIntervalSlider" Minimum="80" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="文字颜色"/>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBox x:Name="ForegroundBox"/>
                    <WrapPanel>
                        <Button Content="白色" Tag="#f8fafc" Margin="0,0,8,0" Click="ForegroundPreset_Click"/>
                        <Button Content="青色" Tag="#22d3ee" Margin="0,0,8,0" Click="ForegroundPreset_Click"/>
                        <Button Content="暖黄" Tag="#fde68a" Click="ForegroundPreset_Click"/>
                    </WrapPanel>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="背景颜色"/>
                <StackPanel Grid.Row="4" Grid.Column="1">
                    <TextBox x:Name="BackgroundBox"/>
                    <WrapPanel>
                        <Button Content="深蓝" Tag="#111827" Margin="0,0,8,0" Click="BackgroundPreset_Click"/>
                        <Button Content="墨黑" Tag="#020617" Margin="0,0,8,0" Click="BackgroundPreset_Click"/>
                        <Button Content="靛紫" Tag="#1e1b4b" Click="BackgroundPreset_Click"/>
                    </WrapPanel>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="识别兜底"/>
                <CheckBox x:Name="OcrBox" Grid.Row="5" Grid.Column="1" Content="启用 OCR 兜底"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="放大镜模式"/>
                <CheckBox x:Name="MagnifierBox" Grid.Row="6" Grid.Column="1" Content="启用放大镜模式"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="系统启动"/>
                <CheckBox x:Name="StartupBox" Grid.Row="7" Grid.Column="1" Content="开机自动启动 HoverText"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="默认值"/>
                <Button Grid.Row="8" Grid.Column="1" Content="恢复默认设置" HorizontalAlignment="Left" Click="Reset_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="104" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="保存" Width="118" Background="#0891b2" BorderBrush="#22d3ee" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
