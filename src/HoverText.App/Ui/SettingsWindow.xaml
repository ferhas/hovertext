<Window x:Class="HoverText.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverText Settings"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="580"
        Background="#0b1020"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121a2c"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#182237"/>
        <SolidColorBrush x:Key="TextBrush" Color="#f8fafc"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9fb0c6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22d3ee"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,16"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#22d3ee"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#26344f"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="HoverText 设置"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="调整触发键、悬浮字号、刷新速度、颜色、OCR 和开机自启。"
                           FontSize="17"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="触发键"/>
                    <ComboBox x:Name="TriggerKeyBox" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="悬浮字号"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                        <TextBlock x:Name="FontSizeValue" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <Slider x:Name="FontSizeSlider" Minimum="32" Maximum="72" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="刷新间隔"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                        <TextBlock x:Name="PollIntervalValue" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <Slider x:Name="PollIntervalSlider" Minimum="80" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="文字颜色"/>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBox x:Name="ForegroundBox"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="白色" Tag="#f8fafc" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                            <Button Content="青色" Tag="#22d3ee" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                            <Button Content="暖黄" Tag="#fde68a" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="背景颜色"/>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBox x:Name="BackgroundBox"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="深蓝" Tag="#111827" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                            <Button Content="墨黑" Tag="#020617" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                            <Button Content="紫灰" Tag="#1e1b4b" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="识别兜底"/>
                    <CheckBox x:Name="OcrBox" Grid.Row="5" Grid.Column="1" Content="启用 OCR 兜底"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="系统启动"/>
                    <CheckBox x:Name="StartupBox" Grid.Row="6" Grid.Column="1" Content="开机自动启动 HoverText"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="默认值"/>
                    <Button Grid.Row="7" Grid.Column="1" Content="恢复默认设置" HorizontalAlignment="Left" Click="Reset_Click"/>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Width="96" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="保存" Width="110" Background="#0891b2" BorderBrush="#22d3ee" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
