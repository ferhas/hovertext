<Window x:Class="HoverText.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverText Settings"
        Width="600"
        Height="680"
        MinWidth="560"
        MinHeight="620"
        Background="#080d18"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#080d18"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0f172a"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="TextBrush" Color="#f8fafc"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#a8b3c7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22d3ee"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,18"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26344f"/>
                    <Setter Property="BorderBrush" Value="#22d3ee"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="24"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#26344f"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="HoverText Settings"
                           FontSize="32"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Click the tray icon to open this panel. Save applies changes immediately."
                           FontSize="18"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Trigger key"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,18">
                        <Button x:Name="AltButton" Content="Alt" Width="88" Margin="0,0,8,0" Click="TriggerButton_Click"/>
                        <Button x:Name="ControlButton" Content="Ctrl" Width="88" Margin="0,0,8,0" Click="TriggerButton_Click"/>
                        <Button x:Name="ShiftButton" Content="Shift" Width="88" Click="TriggerButton_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Text size"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,18">
                        <TextBlock x:Name="FontSizeValue" FontSize="19" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                        <Slider x:Name="FontSizeSlider" Minimum="56" Maximum="112" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Refresh speed"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,18">
                        <TextBlock x:Name="PollIntervalValue" FontSize="19" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                        <Slider x:Name="PollIntervalSlider" Minimum="80" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Text color"/>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBox x:Name="ForegroundBox"/>
                        <WrapPanel Margin="0,0,0,18">
                            <Button Content="White" Tag="#f8fafc" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                            <Button Content="Cyan" Tag="#22d3ee" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                            <Button Content="Warm" Tag="#fde68a" Margin="0,0,8,8" Click="ForegroundPreset_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Background"/>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBox x:Name="BackgroundBox"/>
                        <WrapPanel Margin="0,0,0,18">
                            <Button Content="Navy" Tag="#111827" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                            <Button Content="Black" Tag="#020617" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                            <Button Content="Indigo" Tag="#1e1b4b" Margin="0,0,8,8" Click="BackgroundPreset_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Fallback"/>
                    <CheckBox x:Name="OcrBox" Grid.Row="5" Grid.Column="1" Content="Enable OCR fallback"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Startup"/>
                    <CheckBox x:Name="StartupBox" Grid.Row="6" Grid.Column="1" Content="Start HoverText with Windows"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Defaults"/>
                    <Button Grid.Row="7" Grid.Column="1" Content="Restore defaults" HorizontalAlignment="Left" Click="Reset_Click"/>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Width="104" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Save" Width="118" Background="#0891b2" BorderBrush="#22d3ee" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
